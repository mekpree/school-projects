#include "grlib.h"
#include "Sharp96x96.h"
#include "HAL_MSP_EXP430FR5969_Sharp96x96.h"
#include "images.h"
#include "driverlib.h"
#include "stdint.h"

void clockInit(void);
void boardInit();
void timerInit();
void Delay(void);
void playAnimation(void);

tContext g_sContext;
uint8_t g_delayCounter = 0;

#define BUTTON_PORT GPIO_PORT_P1
#define BUTTON_PIN  GPIO_PIN7  



uint8_t buttonPressed(void)
{
    return (GPIO_getInputPinValue(BUTTON_PORT, BUTTON_PIN) == 0);
}

uint8_t buttonNewPress(void)
{
    static uint8_t released = 1;
    uint8_t now = buttonPressed();

    if (released && now == 0)
    {
        released = 0;
        return 1; 
    }

    if (now == 1)
        released = 1; 

    return 0;
}

uint8_t delayWithCancel(uint32_t cycles)
{
    while (cycles > 0)
    {
        __delay_cycles(5000);

        if (buttonNewPress()) 
            return 1;

        cycles -= 5000;
    }
    return 0;
}


void main(void)
{
    boardInit();
    clockInit();
    timerInit();

    HAL_LCD_initDisplay();

    PM5CTL0 &= ~LOCKLPM5;
    __enable_interrupt();

    GrContextInit(&g_sContext, &g_sharp96x96LCD);
    GrContextForegroundSet(&g_sContext, ClrBlack);
    GrContextBackgroundSet(&g_sContext, ClrWhite);
    GrContextFontSet(&g_sContext, &g_sFontFixed6x8);
    GrClearDisplay(&g_sContext);
    GrFlush(&g_sContext);

    GPIO_setAsInputPinWithPullUpResistor(BUTTON_PORT, BUTTON_PIN);

    while (1)
    {
        GrClearDisplay(&g_sContext);
        GrStringDraw(&g_sContext, "Press Button", -1, 20, 40, 1);
        GrFlush(&g_sContext);

        while (!buttonPressed());
        __delay_cycles(50000); 
        while (buttonPressed()); 

        playAnimation(); 
    }
}


